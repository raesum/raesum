{
  "server": {
    "port": 3000,
    "protocol": "http",
    "host": "localhost",
    "proxyInUse": "false",
    "proxyPort": 443
  },
  "cors": {
    "allowedOrigins": []
  },
  "connections": {
    "primaryDatabase": {
      "host": null,
      "port": 5432,
      "databaseName": "raesum",
      "credentials": {
        "username": null,
        "password": null
      },
      "ssl": false,
      "maxPoolSize": 20,
      "timeouts": {
        "clientForceTimeout": 15000,
        "idleTimeout": 1000,
        "connectionTimeout": 1000,
        "maxUses": 7500
      }
    },
    "redisCache": {
      "enableCaching": true,
      "host": null,
      "port": 6379,
      "secret": null,
      "connectTimeout": 10000,
      "databaseNumber": 0
    }
  },
  "logging": {
      "level": "verbose",
      "logsEnabled": {
        "file": true,
        "console": true
      },
      "filePath": "logs",
      "filename": "app.log"
  },
  "cloudBasedSecrets": [
    "connections.primaryDatabase.credentials"
  ]
}