{
  "server": {
    "port": 3000,
    "protocol": "http",
    "host": "localhost",
    "proxyInUse": "false",
    "proxyPort": 443
  },
  "cors": {
    "allowedOrigins": []
  },
  "cache": {
    "type": "memory",
    "ttl": 500,
    "prefix": "raesum_cache_"
  },
  "connections": {
    "primaryDatabase": {
      "host": null,
      "port": 5432,
      "database": "raesum",
      "credentials": {
        "username": null,
        "password": null
      },
      "ssl": false,
      "maxPoolSize": 20,
      "timeouts": {
        "clientForceTimeout": 15000,
        "idleTimeout": 1000,
        "connectionTimeout": 1000,
        "maxUses": 7500
      }
    },
    "cache": {
      "redis": {
        "host": null,
        "port": 6379,
        "connectTimeout": 10000,
        "databaseNumber": 0,
        "credentials": {
          "username": null,
          "password": null
        }
      },
      "memory": {}
    }
  },
  "logging": {
      "level": "debug",
      "logsEnabled": {
        "file": true,
        "console": true
      },
      "filePath": "logs",
      "filename": "app.log"
  },
  "aws": {
    "region": "us-east-1",
    "accessKeyId": null,
    "secretAccessKey": null,
    "cognito": {
      "cognitoClientId": null,
      "userPoolId": null,
      "tokenExpiration": 3600000
    }
  },
  "cloudBasedSecrets": [
    "connections.primaryDatabase.credentials"
  ],
  "integrationTestEnabled": {
    "redis": false,
    "aws": false
  }
}