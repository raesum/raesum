{
    "env": {
        "node": true,
        "es2021": true
    },
    "extends": ["eslint:recommended", "prettier"],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "linebreak-style": ["error", "unix"],
        "semi": ["error", "always"],
        "no-unused-vars": ["off"],
        "no-console": "off",
        "prefer-const": "off",
        "no-var": "error",
        "no-useless-escape": "off",
        "no-constant-condition": "off"
    }
}
