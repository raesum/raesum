  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "^3.1033.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1033.0",
    "@aws-sdk/client-secrets-manager": "^3.1033.0",
    "amazon-cognito-identity-js": "^6.3.16",
    "aws-sdk": "^2.1693.0",
    "babel-preset-env": "^1.7.0",
    "cognito-express": "^3.0.4",
    "config": "^3.3.12",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "express-unless": "^2.1.3",
    "express-winston": "^4.2.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.10.1",
    "joi": "^17.13.3",
    "jsonpath": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwk-to-pem": "^2.0.7",
    "jwks-rsa": "^4.0.1",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "pg-pool": "^3.13.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "vitest": "^1.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/register": "^7.28.6",
    "@babel/runtime": "^7.29.2",
    "@faker-js/faker": "^8.4.1",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3"
  },
  "vitest": {
    "environment": "node",
    "globalSetup": "<rootDir>/test/setup.js",
    "globalTeardown": "<rootDir>/test/teardown.js",
    "testIgnore": [
      "/node_modules/"
    ],
    "coverage": {
      "provider": "v8"
    }
  }
}
