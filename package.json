{
  "name": "raesum",
  "version": "1.0.0",
  "description": "Robust API server quickstart",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
